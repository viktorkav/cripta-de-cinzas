; Engine configuration file.
config_version=5

[application]

config/name="Cripta de Cinzas"
config/description="Recorte jogável: ARPG tático isométrico em voxel. Modelos: Tripo Agentic Canvas. Código: Claude Opus 5.5."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0

[autoload]

Dados="*res://scripts/dados.gd"
Sons="*res://scripts/sons.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/default_font_antialiasing=1

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/quality/use_taa=false
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=1
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=3
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/ssao/quality=2
environment/ssao/half_size=true
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/screen_space_roughness_limiter/enabled=true
